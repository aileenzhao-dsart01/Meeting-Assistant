# Server
PORT=3001
HOST=0.0.0.0

# DeepSeek API (OpenAI-compatible)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Alternative LLM providers (future use)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Speech-to-Text provider
# "local" = faster-whisper (Python), "openai" = OpenAI Whisper API (cloud)
STT_PROVIDER=local
# Only needed for STT_PROVIDER=openai (same key works for both LLM & STT)
# OPENAI_API_KEY=sk-your-openai-api-key
# STT_OPENAI_MODEL=whisper-1

# Audio storage path (relative to backend root)
AUDIO_STORAGE_PATH=./audio

# Whisper model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# CORS origin (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173
