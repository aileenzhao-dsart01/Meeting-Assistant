# Server
PORT=3001
HOST=0.0.0.0

# DeepSeek API (OpenAI-compatible)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Alternative LLM providers (future use)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Speech-to-Text provider
# "local" = faster-whisper (Python), "deepgram" = Deepgram Nova-2 (cloud — free $200 credit)
STT_PROVIDER=local
# Only needed for STT_PROVIDER=deepgram — get a free key at https://deepgram.com
# DEEPGRAM_API_KEY=your-deepgram-api-key
# STT_DEEPGRAM_MODEL=nova-3
# DEEPGRAM_KEYWORDS="Ran Zhao:5,PPC:3,ROAS:3"
# DEEPGRAM_FILTER_FILLER=true

# Storage
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=meeting-audio

# Audio storage path (relative to backend root)
AUDIO_STORAGE_PATH=./audio

# Whisper model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=base

# Audio Normalization — speech frequency band enhancement
# Keeps only 200-4500 Hz (human speech range), no noise reduction distortion
AUDIO_NORMALIZE=true
AUDIO_TARGET_LOUDNESS=-14
AUDIO_CLARITY_MODE=speech

# CORS origin (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173
