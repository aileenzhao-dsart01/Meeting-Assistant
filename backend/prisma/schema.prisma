generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Workspaces ─────────────────────────────────────────────────────

model Workspace {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   WorkspaceMember[]
  meetings  Meeting[]
  invites   WorkspaceInvite[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("member") // owner | admin | member | viewer
  createdAt   DateTime  @default(now())

  // Supabase user UUID (no relation — auth is managed by Supabase)
  userId      String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ── Meetings & Tasks ───────────────────────────────────────────────

model Meeting {
  id           String   @id @default(cuid())
  title        String
  date         DateTime @default(now())
  duration     Int?
  status       String   @default("pending") // pending | uploading | transcribing | summarizing | complete | error
  recordingUrl String?  // path to audio file
  transcript   String?  // raw transcript text
  summary      String?  // markdown summary
  bulletPoints String?  // JSON array of bullet points
  topics       String?  // JSON array of detected marketing topics
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  createdBy   String?        // Supabase user UUID
  tasks       Task[]
  shares      MeetingShare[]
}

model Task {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String
  assignee    String?
  status      String   @default("open") // open | in_progress | done
  priority    String?  // high | medium | low
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Workspace Invites (email-based) ─────────────────────────────────

model WorkspaceInvite {
  id             String    @id @default(cuid())
  email          String    // invited user's email
  role           String    @default("member") // admin | member | viewer
  status         String    @default("pending") // pending | accepted | declined
  invitedById    String    // Supabase user UUID who sent the invite
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ── Meeting Shares (user-level sharing for viewer access) ──────────

model MeetingShare {
  id               String   @id @default(cuid())
  meetingId        String
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sharedWithUserId String   // Supabase user UUID — the user who can view
  sharedByUserId   String   // Supabase user UUID — who shared it
  sharedAt         DateTime @default(now())

  @@unique([meetingId, sharedWithUserId])
}
