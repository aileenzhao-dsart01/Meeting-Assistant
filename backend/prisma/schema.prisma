generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Users & Workspaces ──────────────────────────────────────────────

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  WorkspaceMember[]
}

model Workspace {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        WorkspaceMember[]
  meetings       Meeting[]
  sharedMeetings SharedMeeting[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("member") // owner | admin | member
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model SharedMeeting {
  id              String    @id @default(cuid())
  meetingId       String
  meeting         Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  workspaceId     String    // target workspace that can see this meeting
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sharedAt        DateTime  @default(now())
  sharedByUserId  String?

  @@unique([meetingId, workspaceId])
}

// ── Meetings & Tasks ─────────────────────────────────────────────────

model Meeting {
  id           String   @id @default(cuid())
  title        String
  date         DateTime @default(now())
  duration     Int?
  status       String   @default("pending") // pending | uploading | transcribing | summarizing | complete | error
  recordingUrl String?  // path to audio file
  transcript   String?  // raw transcript text
  summary      String?  // markdown summary
  bulletPoints String?  // JSON array of bullet points
  topics       String?  // JSON array of detected marketing topics
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id])
  tasks       Task[]
  sharedTo    SharedMeeting[]
}

model Task {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String
  assignee    String?
  status      String   @default("open") // open | in_progress | done
  priority    String?  // high | medium | low
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
